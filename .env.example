# 复制为 .env 供本地运行使用；GitHub 上请配置到 Settings → Secrets → Actions

# 必填：Steam Web API Key（https://steamcommunity.com/dev/apikey）
STEAM_API_KEY=

# 必填：你的 SteamID64（17 位数字，https://steamid.io 查询）
STEAM_ID=

# 必填：飞书群自定义机器人 Webhook 地址
FEISHU_WEBHOOK=

# 可选：飞书机器人签名密钥（机器人开启“签名校验”时必填）
FEISHU_SECRET=

# 可选：战报日期所用时区（IANA 名称，默认 Asia/Shanghai）
REPORT_TIMEZONE=Asia/Shanghai

# 可选：每日发送时刻（HH:MM，多个用英文逗号分隔，默认 22:00）。
# CI 每半小时轮询一次，到点后第一次轮询发送；一天可发多次，
# 每次都与「前一天最后一次快照」比较；无前一日数据时发送初始化卡片。
REPORT_TIME=22:00

# 可选：true 时忽略「发送时刻与当日已发送」检查，强制发送
FORCE_SEND=false
